# PostgreSQL. Development default: embedded Postgres in a local folder (no install needed).
# Production: any Postgres server, e.g. postgres://user:password@host:5432/reclip (append ?sslmode=require
# for managed providers such as Neon or Supabase).
DATABASE_URL="pglite:./.data/dev"
# DATABASE_POOL_MAX=10
SESSION_SECRET="dev-only-change-me-in-production-0123456789abcdef"
STORAGE_DIR="./storage"               # local document storage (used when S3_BUCKET is not set)
# S3-compatible document storage (AWS S3, Cloudflare R2, Backblaze B2, MinIO). Needed to run
# more than one app instance. Leave S3_BUCKET unset to keep documents on local disk.
# S3_BUCKET=reclip-documents
# S3_REGION=auto                      # e.g. eu-west-1 for AWS; "auto" for Cloudflare R2
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # omit for AWS S3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false           # true for MinIO
# S3_SSE=AES256                       # ask S3 to encrypt at rest (leave unset for R2, which always does)
EXTRACTION_PROVIDER="mock"
SEMANTIC_PROVIDER="local"
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Password reset email (SMTP). Without these, reset links are only shown in development.
APP_URL="http://localhost:3000"       # public base URL used in email links
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                       # 465 uses implicit TLS
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Reclip <no-reply@example.com>"

# How many reverse proxies sit in front of the app (Railway, Fly, Render, nginx: 1).
# Used to read the real client IP for rate limiting. Defaults to 1 in production, 0 in dev.
# TRUSTED_PROXY_HOPS=1
